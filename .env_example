# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Django Backend API
DBOT_API_URL=http://localhost:8000/api/dbot
DBOT_AUTH_KEY=your_api_key_here
APP_LOGIN_URL=https://app.coalitionracing.com/accounts/login/
# Where /connect_zwift points. Defaults to the production page if unset.
APP_ZWIFT_CONNECT_URL=https://app.coalitionracing.com/user/zauth/

# Role Configuration
TEAM_MEMBER_ROLE_ID=your_team_member_role_id_here

# New member welcome messages sent here
NEW_ARRIVALS_CHANNEL_ID=your_new_arrivals_channel_id_here

# Optional Settings
DEBUG=false
LOGFIRE_ENVIRONMENT=development